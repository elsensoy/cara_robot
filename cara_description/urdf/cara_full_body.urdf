  <joint name="l_hip_yaw" type="revolute">
    <!-- purpose: Rotation of the whole leg about the vertical. Sets foot heading for turning and for directional foot placement. -->
    <!-- +angle: toe yaws toward +Y (toe-out / outward heading) -->
    <parent link="pelvis"/>
    <child link="l_hip_yaw_link"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.79" upper="0.79" effort="3" velocity="6"/>  <!-- effort/velocity: TBD placeholder -->
    <dynamics damping="0.0" friction="0.0"/>  <!-- TODO: measured -->
  </joint>

  <joint name="l_hip_roll" type="revolute">
    <!-- purpose: Hip abduction/adduction. Lateral balance, stance width, side-stepping. -->
    <!-- +angle: thigh abducts - knee moves toward +Y, away from midline -->
    <parent link="l_hip_yaw_link"/>
    <child link="l_hip_roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.52" upper="0.61" effort="3" velocity="6"/>  <!-- effort/velocity: TBD placeholder -->
    <dynamics damping="0.0" friction="0.0"/>  <!-- TODO: measured -->
  </joint>

  <joint name="l_hip_pitch" type="revolute">
    <!-- purpose: Fore/aft thigh swing. Primary driver of walking stride length. -->
    <!-- +angle: thigh swings REARWARD (hip extension); negative = forward flexion -->
    <parent link="l_hip_roll_link"/>
    <child link="l_thigh"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.05" effort="3" velocity="6"/>  <!-- effort/velocity: TBD placeholder -->
    <dynamics damping="0.0" friction="0.0"/>  <!-- TODO: measured -->
  </joint>

  <joint name="l_knee_pitch" type="revolute">
    <!-- purpose: Knee flexion; extension is blocked at 0. Swing-leg ground clearance, stance-phase shock absorption, crouch depth. -->
    <!-- +angle: shin swings rearward relative to thigh (knee FLEXION) -->
    <parent link="l_thigh"/>
    <child link="l_shin"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.36" effort="3" velocity="6"/>  <!-- effort/velocity: TBD placeholder -->
    <dynamics damping="0.0" friction="0.0"/>  <!-- TODO: measured -->
  </joint>

  <joint name="l_ankle_pitch" type="revolute">
    <!-- purpose: Ankle plantar/dorsiflexion. Fore/aft centre-of-pressure control, push-off, swing-phase toe clearance. -->
    <!-- +angle: toe drops (plantarflexion); negative = dorsiflexion -->
    <parent link="l_shin"/>
    <child link="l_ankle_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87" upper="0.61" effort="2" velocity="6"/>  <!-- effort/velocity: TBD placeholder -->
    <dynamics damping="0.0" friction="0.0"/>  <!-- TODO: measured -->
  </joint>

  <joint name="l_ankle_roll" type="revolute">
    <!-- purpose: Sole tilt. Lateral centre-of-pressure control, adaptation to uneven ground. -->
    <!-- +angle: sole tilts outer-edge-up (inversion) -->
    <parent link="l_ankle_link"/>
    <child link="l_foot"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.44" upper="0.44" effort="2" velocity="6"/>  <!-- effort/velocity: TBD placeholder -->
    <dynamics damping="0.0" friction="0.0"/>  <!-- TODO: measured -->
  </joint>

  <joint name="base_to_torso" type="fixed">
