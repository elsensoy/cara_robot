    <origin xyz="0 -0.09 0.12" rpy="0 0 0"/>
  </joint>

  <joint name="r_ear_joint" type="fixed">
    <!-- declared type: revolute (locked at 0) -->
    <parent link="head"/>
    <child link="r_ear"/>
    <origin xyz="0.005 -0.055 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="r_ear_servo_mount" type="fixed">
    <!-- declared type: fixed -->
    <parent link="head"/>
    <child link="r_ear_servo"/>
    <origin xyz="0.005 -0.03 0.045" rpy="0 0 0"/>
  </joint>

</robot>
